<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260728000000-1" author="colocimmo">
        <createTable tableName="conversation">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date_creation" type="datetime"><constraints nullable="false"/></column>
            <column name="dernier_message_le" type="datetime"/>
            <column name="annonce_id" type="bigint"><constraints nullable="false"/></column>
            <column name="participant1_id" type="bigint"><constraints nullable="false"/></column>
            <column name="participant2_id" type="bigint"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="conversation"
            columnNames="annonce_id, participant1_id, participant2_id"
            constraintName="ux_conversation_paire"/>
    </changeSet>

    <changeSet id="20260728000000-2" author="colocimmo">
        <createTable tableName="message">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="contenu" type="varchar(2000)"><constraints nullable="false"/></column>
            <column name="date_envoi" type="datetime"><constraints nullable="false"/></column>
            <column name="lu" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="conversation_id" type="bigint"><constraints nullable="false"/></column>
            <column name="expediteur_id" type="bigint"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="20260728000000-3" author="colocimmo">
        <addForeignKeyConstraint baseColumnNames="annonce_id" baseTableName="conversation"
            constraintName="fk_conversation__annonce_id" referencedColumnNames="id" referencedTableName="annonce"/>
        <addForeignKeyConstraint baseColumnNames="participant1_id" baseTableName="conversation"
            constraintName="fk_conversation__p1_id" referencedColumnNames="id" referencedTableName="jhi_user"/>
        <addForeignKeyConstraint baseColumnNames="participant2_id" baseTableName="conversation"
            constraintName="fk_conversation__p2_id" referencedColumnNames="id" referencedTableName="jhi_user"/>
        <addForeignKeyConstraint baseColumnNames="conversation_id" baseTableName="message"
            constraintName="fk_message__conversation_id" referencedColumnNames="id" referencedTableName="conversation"/>
        <addForeignKeyConstraint baseColumnNames="expediteur_id" baseTableName="message"
            constraintName="fk_message__expediteur_id" referencedColumnNames="id" referencedTableName="jhi_user"/>
    </changeSet>

</databaseChangeLog>
